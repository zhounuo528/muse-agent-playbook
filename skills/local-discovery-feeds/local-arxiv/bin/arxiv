#!/usr/bin/env python3
"""ArXiv AI 论文日报：抓取 cs.AI / cs.LG / cs.CL 等分类的最新论文。

用法：
  arxiv                        # 默认：最近 1 天，cs.AI+cs.LG+cs.CL，最多 20 篇
  arxiv --days 3               # 最近 3 天
  arxiv --category cs.CL        # 只看计算语言学
  arxiv --max 10               # 最多 10 篇
"""
import sys
import json
import argparse
import urllib.request
import urllib.parse
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta, timezone

UA = {"User-Agent": "playbook-feeds/1.0"}
NS = {"a": "http://www.w3.org/2005/Atom"}


def fetch(category, max_results):
    q = urllib.parse.urlencode({
        "search_query": f"cat:{category}",
        "start": 0,
        "max_results": max_results,
        "sortBy": "submittedDate",
        "sortOrder": "descending",
    })
    url = "http://export.arxiv.org/api/query?" + q
    req = urllib.request.Request(url, headers=UA, method="GET")
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.read().decode("utf-8")


def parse(xml_text, days):
    root = ET.fromstring(xml_text)
    cutoff = datetime.now(timezone.utc) - timedelta(days=days)
    out = []
    for e in root.findall("a:entry", NS):
        pub_raw = (e.findtext("a:published", default="", namespaces=NS) or "").strip()
        try:
            pub = datetime.fromisoformat(pub_raw.replace("Z", "+00:00"))
        except ValueError:
            continue
        if pub < cutoff:
            continue
        authors = [a.findtext("a:name", default="", namespaces=NS)
                   for a in e.findall("a:author", NS)]
        cats = [c.get("term") for c in e.findall("a:category", NS)]
        link = ""
        for l in e.findall("a:link", NS):
            if l.get("rel") == "alternate":
                link = l.get("href", "")
                break
        summary = (e.findtext("a:summary", default="", namespaces=NS) or "").strip()
        summary = " ".join(summary.split())[:600]
        out.append({
            "title": " ".join((e.findtext("a:title", default="", namespaces=NS) or "").split()),
            "authors": authors[:6],
            "summary": summary,
            "url": link,
            "published": pub_raw[:10],
            "categories": cats,
        })
    return out


def main():
    ap = argparse.ArgumentParser(description="ArXiv AI 论文日报")
    ap.add_argument("--days", type=int, default=1, help="最近 N 天（默认 1）")
    ap.add_argument("--category", default="cs.AI,cs.LG,cs.CL",
                    help="逗号分隔的分类（默认 cs.AI,cs.LG,cs.CL）")
    ap.add_argument("--max", type=int, default=20, help="每类最多篇数（默认 20）")
    a = ap.parse_args()

    papers, seen = [], set()
    errors = []
    for cat in [c.strip() for c in a.category.split(",") if c.strip()]:
        try:
            for p in parse(fetch(cat, a.max), a.days):
                key = p["url"] or p["title"]
                if key not in seen:
                    seen.add(key)
                    papers.append(p)
        except Exception as ex:
            errors.append({"category": cat, "error": str(ex)[:200]})

    papers.sort(key=lambda p: p["published"], reverse=True)
    print(json.dumps({"papers": papers[: a.max * 2], "errors": errors},
                     ensure_ascii=False, indent=1)[:30000])


if __name__ == "__main__":
    main()
