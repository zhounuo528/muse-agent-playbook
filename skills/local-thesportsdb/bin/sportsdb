#!/usr/bin/env python3
"""TheSportsDB 免费 V1 接口：球队搜索、赛程、比分。

公开测试 key（官方文档化，非密钥），无需注册：
  https://www.thesportsdb.com/api/v1/json/123/...

用法：
  sportsdb --team Liverpool            # 球队信息
  sportsdb --next 133602               # 球队未来赛程
  sportsdb --last 133602               # 球队近期战绩
  sportsdb --nextleague 4480           # 联赛未来赛程（4480=欧冠）
  sportsdb --lastleague 4328           # 联赛近期战绩（4328=英超）
"""
import sys
import json
import argparse
import urllib.request
import urllib.parse

BASE = "https://www.thesportsdb.com/api/v1/json/123"
# 官方公开测试 key；付费 key 走 V2 + X-API-KEY，本 CLI 暂不用


def get(endpoint, params):
    url = f"{BASE}/{endpoint}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, method="GET",
                                 headers={"User-Agent": "playbook-sportsdb/1.0"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read().decode("utf-8"))


def fmt_event(e):
    return {
        "date": e.get("dateEvent"), "time": (e.get("strTimestamp") or "")[:16],
        "league": e.get("strLeague"), "round": e.get("intRound"),
        "home": e.get("strHomeTeam"), "away": e.get("strAwayTeam"),
        "score": f"{e.get('intHomeScore')}-{e.get('intAwayScore')}"
                 if e.get("intHomeScore") is not None else "vs",
        "venue": e.get("strVenue"),
    }


def main():
    ap = argparse.ArgumentParser(description="TheSportsDB 免费查询")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--team", metavar="NAME", help="球队搜索")
    g.add_argument("--next", metavar="TEAM_ID", help="球队未来赛程")
    g.add_argument("--last", metavar="TEAM_ID", help="球队近期战绩")
    g.add_argument("--nextleague", metavar="LEAGUE_ID", help="联赛未来赛程")
    g.add_argument("--lastleague", metavar="LEAGUE_ID", help="联赛近期战绩")
    a = ap.parse_args()

    if a.team:
        d = get("searchteams.php", {"t": a.team})
        teams = d.get("teams") or []
        out = [{"id": t.get("idTeam"), "name": t.get("strTeam"),
                "league": t.get("strLeague"), "league_id": t.get("idLeague"),
                "stadium": t.get("strStadium")}
               for t in teams[:5]]
    elif a.next:
        d = get("eventsnext.php", {"id": a.next})
        out = [fmt_event(e) for e in (d.get("events") or [])[:10]]
    elif a.last:
        d = get("eventslast.php", {"id": a.last})
        out = [fmt_event(e) for e in (d.get("events") or [])[:10]]
    elif a.nextleague:
        d = get("eventsnextleague.php", {"id": a.nextleague})
        out = [fmt_event(e) for e in (d.get("events") or [])[:15]]
    else:
        d = get("eventspastleague.php", {"id": a.lastleague})
        out = [fmt_event(e) for e in (d.get("events") or [])[:15]]
    print(json.dumps(out, ensure_ascii=False, indent=1)[:8000])


if __name__ == "__main__":
    main()
