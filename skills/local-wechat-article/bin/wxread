#!/usr/bin/env python3
"""Fetch a WeChat Official Account article (mp.weixin.qq.com) as clean text/Markdown.

WeChat article pages are server-side rendered. The anti-bot wall ("环境异常"
verification page) triggers on non-WeChat user agents, so this fetches with a
mobile WeChat UA via curl (which picks up the VM egress proxy from the env).

Usage:
  wxread <mp.weixin.qq.com article URL>          # plain text to stdout (fast read)
  wxread <url> --md                              # rich Markdown (formatting kept)
  wxread <url> --json                            # structured JSON (plain text body)
  wxread <url> --save <path.md>                  # write a rich-Markdown document file

The rich-Markdown conversion uses markdownify inside this skill's .venv
(pip package markdownify + beautifulsoup4; create the venv next to this
skill folder and point the shebang at it, or just use plain-text mode).
If markdownify is unavailable the tool
falls back to the plain-text body and says so on stderr.
"""
import sys, os, re, html, json, subprocess, datetime
import urllib.parse

UA = ("Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) "
      "AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 "
      "MicroMessenger/8.0.49(0x18003122) NetType/WIFI Language/zh_CN")

ALLOWED_HOST = "mp.weixin.qq.com"


def validate_url(url):
    """只许抓公众号域名本身：拒绝其他域名、本地路径与非 http(s) 协议，
    免得调用方（或被注入的文本）把抓取器当成任意 URL/本地文件读取器。"""
    u = urllib.parse.urlparse(url)
    if u.scheme not in ("http", "https"):
        return "只支持 http/https 链接"
    if (u.hostname or "").lower() != ALLOWED_HOST:
        return f"只支持 {ALLOWED_HOST} 的文章链接"
    return ""


def fetch(url):
    """返回 (正文, 错误)。curl 退出码非 0 时如实报错，不把空响应
    误标成验证墙（旧版忽略退出码、空响应与被墙无法区分）。"""
    out = subprocess.run(
        ["curl", "-s", "-L", "--max-redirs", "5",
         "--proto", "=http,https", "--proto-redir", "=http,https",
         "--max-time", "45", "-A", UA, url],
        capture_output=True)
    if out.returncode != 0:
        return "", f"curl 退出码 {out.returncode}"
    return out.stdout.decode("utf-8", "ignore"), ""


def grab(raw, pats):
    for p in pats:
        m = re.search(p, raw, re.S)
        if m:
            return html.unescape(m.group(1).strip())
    return ""


UI_TAIL = {"预览时标签不可点", "不喜欢", "微信扫一扫", "关注该公众号",
           "知道了", "使用小程序", "取消", "允许", "×", "分析",
           "微信扫一扫可打开此内容，", "使用完整服务"}


def clean_tail(text):
    lines = text.split("\n")
    while lines and (not lines[-1].strip() or lines[-1].strip() in UI_TAIL):
        lines.pop()
    return "\n".join(lines)


def slice_segment(raw):
    i = raw.find('id="js_content"')
    if i < 0:
        return ""
    seg = raw[i:]
    for marker in ('class="rich_media_area_extra"', 'id="js_sg_bar"',
                   'id="js_article_bottom_bar"', 'class="rich_media_tool'):
        j = seg.find(marker)
        if j > 0:
            seg = seg[:j]
            break
    seg = re.sub(r'<script.*?</script>', '', seg, flags=re.S)
    seg = re.sub(r'<style.*?</style>', '', seg, flags=re.S)
    return seg


def extract_body(raw):
    seg = slice_segment(raw)
    if not seg:
        return ""
    seg = re.sub(r'<img[^>]*data-src="([^"]+)"[^>]*>', r'\n![图](\1)\n', seg)
    seg = re.sub(r'<br\s*/?>', '\n', seg)
    seg = re.sub(r'</p>|</section>|</h\d>|</li>|</div>|</blockquote>', '\n', seg)
    seg = re.sub(r'<[^>]+>', '', seg)
    body = html.unescape(seg)
    body = re.sub(r'[ \t\u00a0]+', ' ', body)
    body = re.sub(r'\n\s*\n+', '\n', body).strip()
    body = body.replace('id="js_content" style="visibility: hidden; opacity: 0; "', '')
    return clean_tail(body.strip())


def extract_body_md(raw):
    seg = slice_segment(raw)
    if not seg:
        return ""
    try:
        from markdownify import markdownify
    except ImportError:
        print("markdownify unavailable, falling back to plain text",
              file=sys.stderr)
        return extract_body(raw)
    # WeChat lazy-loads images: the real URL is in data-src, src is a placeholder.
    seg = re.sub(r'\ssrc="data:image[^"]*"', '', seg)
    seg = seg.replace('data-src="', 'src="')
    md = markdownify(seg, heading_style="ATX", strip=["script", "style"])
    md = html.unescape(md)
    md = re.sub(r'\n{3,}', '\n\n', md).strip()
    lines = md.split("\n")
    for idx, line in enumerate(lines[:3]):
        if 'visibility: hidden' in line and 'js' in line:
            del lines[idx]
            break
    md = "\n".join(lines).strip()
    return clean_tail(md)


def main():
    argv = sys.argv[1:]
    as_json = "--json" in argv
    as_md = "--md" in argv
    save_path = None
    if "--save" in argv:
        k = argv.index("--save")
        save_path = argv[k + 1] if k + 1 < len(argv) else None
    args = [a for a in argv if not a.startswith("--")
            and (save_path is None or a != save_path)]
    if not args:
        print("usage: wxread <mp.weixin.qq.com url> [--json] [--save path.md]",
              file=sys.stderr)
        return 2
    bad = validate_url(args[0])
    if bad:
        print("BAD_URL: " + bad, file=sys.stderr)
        return 2
    if save_path and os.path.exists(save_path) and "--force" not in argv:
        print("SAVE_REFUSED: 目标文件已存在，不覆盖；确需覆盖加 --force",
              file=sys.stderr)
        return 2
    raw, ferr = fetch(args[0])
    if ferr:
        print("FETCH_FAILED: " + ferr, file=sys.stderr)
        return 1
    if not raw or ('id="js_content"' not in raw and "环境异常" in raw):
        print("FETCH_BLOCKED: WeChat served a verification page, no article body",
              file=sys.stderr)
        return 1
    if 'id="js_content"' not in raw:
        print("FETCH_FAILED: page fetched but no js_content block found",
              file=sys.stderr)
        return 1
    title = grab(raw, [r'property="og:title" content="([^"]*)"'])
    author = grab(raw, [r'property="og:article:author" content="([^"]*)"'])
    nick = grab(raw, [r'id="js_name"[^>]*>\s*([^<]+)',
                      r'var nickname = htmlDecode\("([^"]*)"\)',
                      r'"nick_name"\s*:\s*"([^"]*)"'])
    pub = ""
    m = re.search(r'var ct = "?(\d{10})"?', raw)
    if m:
        tz = datetime.timezone(datetime.timedelta(hours=8))
        pub = datetime.datetime.fromtimestamp(
            int(m.group(1)), tz).strftime("%Y-%m-%d %H:%M")
    body = extract_body(raw)
    if as_json:
        print(json.dumps({"title": title, "mp_name": nick, "author": author,
                          "publish_time": pub, "content": body,
                          "chars": len(body)}, ensure_ascii=False, indent=2))
        return 0
    header = "# " + title + "\n\n"
    meta = " · ".join(x for x in (nick, author, pub) if x)
    if meta:
        header += meta + "\n\n"
    md = header + (extract_body_md(raw) if as_md else body) + "\n"
    if save_path:
        doc = header + extract_body_md(raw) + "\n"
        os.makedirs(os.path.dirname(os.path.abspath(save_path)), exist_ok=True)
        with open(save_path, "w", encoding="utf-8") as f:
            f.write(doc)
        print("saved: " + save_path + f" ({len(doc)} chars)", file=sys.stderr)
    print(md)
    return 0


if __name__ == "__main__":
    sys.exit(main())
