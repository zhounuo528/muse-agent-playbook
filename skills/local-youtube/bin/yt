#!/usr/bin/env python3
"""YouTube 字幕抓取（经 Piped 第三方 API，绕过 YouTube 对云 IP 的封锁）.

用法:
    yt "https://www.youtube.com/watch?v=VIDEO_ID"
    yt VIDEO_ID
    yt VIDEO_ID --lang zh        # 优先中文
输出 JSON: {video_id, title, language, language_code, transcript, error}
"""
import ipaddress
import json
import re
import sys
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

# 可用的 Piped API 实例（按优先级）。实例经常挂，逐个尝试。
PIPED_INSTANCES = [
    "https://pipedapi.ducks.party",
    "https://pipedapi.adminforge.de",
    "https://pipedapi.leptons.xyz",
    "https://pipedapi.osphost.fi",
    "https://pipedapi.reallyaweso.me",
    "https://pipedapi.kavin.rocks",
    "https://pipedapi.drgns.space",
    "https://pipedapi.darkness.services",
]

TIMEOUT = 25


def extract_video_id(s):
    s = s.strip()
    # youtu.be/ID
    m = re.search(r"youtu\.be/([A-Za-z0-9_-]{11})", s)
    if m:
        return m.group(1)
    # watch?v=ID / /shorts/ID / /embed/ID / /live/ID
    m = re.search(r"(?:v=|/shorts/|/embed/|/live/)([A-Za-z0-9_-]{11})", s)
    if m:
        return m.group(1)
    # 裸 ID
    if re.fullmatch(r"[A-Za-z0-9_-]{11}", s):
        return s
    return None


def http_get(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return r.read()


def safe_remote_url(url):
    """字幕 URL 来自第三方实例的返回值，不能盲信：只放行公网 http(s)，
    拒绝本地/内网地址，防 SSRF 与本地文件读取。"""
    u = urllib.parse.urlparse(url or "")
    if u.scheme not in ("http", "https"):
        return False
    host = (u.hostname or "").lower()
    if not host or host == "localhost" or host.endswith(".local"):
        return False
    try:
        ip = ipaddress.ip_address(host)
        return ip.is_global
    except ValueError:
        return True  # 普通域名，放行（不做 DNS 解析，避免慢与误杀）


def pick_subtitle(subtitles, lang_pref):
    """按语言偏好挑字幕轨道：en -> zh -> 其他。返回 (track, 实际语言名)。"""
    def norm(code):
        return (code or "").lower()

    # 构造偏好顺序
    prefs = []
    if lang_pref:
        prefs.append(lang_pref.lower())
    prefs += ["en", "zh", "zh-hans", "zh-cn", "zh-hant", "zh-tw"]

    # 精确匹配优先
    for p in prefs:
        for t in subtitles:
            if norm(t.get("code")) == p or norm(t.get("code")).startswith(p + "-"):
                return t
    # 退回第一个可用
    return subtitles[0] if subtitles else None


def parse_ttml(xml_bytes):
    """从 TTML/XML 字幕提取纯文本，去重连续重复行。"""
    try:
        root = ET.fromstring(xml_bytes)
    except ET.ParseError:
        return None
    # 兼容带/不带命名空间
    texts = []
    for p in root.iter():
        if p.tag.endswith("}p") or p.tag == "p":
            txt = "".join(p.itertext()).strip()
            # 去掉 [Music] / [Applause] 之类标记
            txt = re.sub(r"\[.*?\]", "", txt).strip()
            if txt and (not texts or texts[-1] != txt):
                texts.append(txt)
    return " ".join(texts)


def fetch_transcript(video_id, lang_pref=None):
    last_err = "all instances failed"
    for inst in PIPED_INSTANCES:
        try:
            data = json.loads(http_get(f"{inst}/streams/{video_id}").decode("utf-8"))
        except Exception as e:
            last_err = f"{inst}: {e}"
            continue
        if "error" in data:
            last_err = f"{inst}: {str(data['error'])[:100]}"
            continue
        title = data.get("title")
        subtitles = data.get("subtitles") or []
        if not subtitles:
            return {"video_id": video_id, "title": title,
                    "error": "no_captions",
                    "error_detail": "该视频没有可用字幕"}
        track = pick_subtitle(subtitles, lang_pref)
        if not safe_remote_url(track.get("url")):
            last_err = f"{inst}: subtitle URL 不在放行范围"
            continue
        try:
            xml_bytes = http_get(track["url"])
        except Exception as e:
            last_err = f"{inst}: subtitle fetch failed: {e}"
            continue
        text = parse_ttml(xml_bytes)
        if not text:
            last_err = f"{inst}: empty transcript"
            continue
        return {
            "video_id": video_id,
            "title": title,
            "language": track.get("name"),
            "language_code": track.get("code"),
            "transcript": text,
        }
    return {"video_id": video_id, "error": "fetch_failed", "error_detail": last_err}


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--lang")]
    lang = None
    for i, a in enumerate(sys.argv):
        if a == "--lang" and i + 1 < len(sys.argv):
            lang = sys.argv[i + 1]
    if not args:
        print(json.dumps({"error": "usage",
                          "error_detail": "用法: yt <YouTube链接或视频ID> [--lang zh]"},
                         ensure_ascii=False))
        sys.exit(2)
    video_id = extract_video_id(args[0])
    if not video_id:
        print(json.dumps({"error": "bad_input",
                          "error_detail": "无法识别视频 ID，请传入 YouTube 链接或 11 位视频 ID"},
                         ensure_ascii=False))
        sys.exit(2)
    result = fetch_transcript(video_id, lang)
    print(json.dumps(result, ensure_ascii=False))
    # 失败必须用退出码说出来：调用方（含脚本编排）只看退出码时，
    # 旧版出错仍 exit 0 会把失败伪装成成功。
    sys.exit(1 if "error" in result else 0)


if __name__ == "__main__":
    main()
